# Variables de entorno de NexoLocal. Copiar a `.env` y rellenar.
#
# `.env` esta en .gitignore y NUNCA se commitea. Este `.env.example` solo documenta
# los nombres: no lleva ningun valor real.
#
# El doble guion bajo es el separador de seccion de la configuracion de .NET:
# Mongo__ConnectionString equivale a { "Mongo": { "ConnectionString": ... } }.
#
# En Azure App Service estas mismas variables se definen como app settings del sitio
# y ganan sobre el archivo: el `.env` es solo para desarrollo local.

# ----------------------------------------------------------------------------
# Un solo proceso: atiende HTTP y despacha el outbox. Ya no hay rol separado.
# ----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ----------------------------------------------------------------------------
# MongoDB Atlas. Una sola cadena y tres bases, una por dominio.
# Local con docker compose: mongodb://localhost:27017/?replicaSet=rs0
# ----------------------------------------------------------------------------
Mongo__ConnectionString=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
Mongo__IdentityDatabase=nexo_identity
Mongo__DiscoveryDatabase=nexo_discovery
Mongo__EngagementDatabase=nexo_engagement
# Pool por instancia. Las instancias del plan no deben agotar el limite del cluster.
Mongo__MaxPoolSize=40

# ----------------------------------------------------------------------------
# Redis: cache L2, lista negra de jti, cuotas exactas, idempotencia y backplane.
# Local con docker compose: localhost:6379
# ----------------------------------------------------------------------------
Redis__ConnectionString=HOST:6380,password=CLAVE,ssl=True,abortConnect=False
Redis__InstanceName=nexo
Redis__ConnectTimeoutMilliseconds=2000
Redis__SyncTimeoutMilliseconds=2000

# ----------------------------------------------------------------------------
# Identidad. Llave HMAC con la que se protege el codigo de verificacion del correo.
# Generar con: openssl rand -base64 32
# ----------------------------------------------------------------------------
Identity__CodeHmacKey=

# ----------------------------------------------------------------------------
# Firma y cifrado de los tokens (OpenIddict).
# Sin estas variables, fuera de Development el arranque FALLA a proposito:
# un certificado de desarrollo en produccion permitiria falsificar tokens.
# Generar el PFX y pasarlo a Base64:
#   openssl req -x509 -newkey rsa:2048 -keyout k.pem -out c.pem -days 730 -nodes -subj "/CN=NexoLocal"
#   openssl pkcs12 -export -out nexo.pfx -inkey k.pem -in c.pem -passout pass:CLAVE
#   base64 -w0 nexo.pfx
# ----------------------------------------------------------------------------
Identity__SigningCertificateBase64=
Identity__SigningCertificatePassword=
Identity__EncryptionCertificateBase64=
Identity__EncryptionCertificatePassword=

# ----------------------------------------------------------------------------
# Correo (MailKit). Lo consume el despachador de outbox dentro de la API.
# Sin estas variables el host NO arranca: encolaria codigos que nadie enviaria.
# Puerto 465 = TLS directo; cualquier otro (587, 2525, 25) = STARTTLS.
# Mailtrap sandbox: sandbox.smtp.mailtrap.io:587 (captura los correos, no los entrega).
# ----------------------------------------------------------------------------
Mail__Host=sandbox.smtp.mailtrap.io
Mail__Port=587
Mail__User=
Mail__Password=
Mail__From=no-reply@nexolocal.mx
Mail__FromName=Nexo Local

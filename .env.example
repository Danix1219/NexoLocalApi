ASPNETCORE_ENVIRONMENT=Development

Mongo__ConnectionString=mongodb://localhost:27017/?replicaSet=rs0
Mongo__IdentityDatabase=nexo_identity
Mongo__DiscoveryDatabase=nexo_discovery
Mongo__EngagementDatabase=nexo_engagement
Mongo__MaxPoolSize=40

Redis__ConnectionString=localhost:6379
Redis__InstanceName=nexo
Redis__ConnectTimeoutMilliseconds=2000
Redis__SyncTimeoutMilliseconds=2000

Identity__CodeHmacKey=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64_KEY
Mail__Host=smtp.gmail.com
Mail__Port=587
Mail__User=REPLACE_WITH_SMTP_USERNAME
Mail__Password=REPLACE_WITH_SMTP_PASSWORD
Mail__From=noreply@example.com
Mail__FromName=Nexolocal
# Photon: uso moderado local; configurar proveedor propio para producción.
Geocoding__BaseUrl=https://photon.komoot.io/

# Medios: configurar solo en backend, nunca APK. Producci?n exige base HTTPS.
MediaStorage__ConnectionString=

# Medios: configurar solo en backend, nunca APK. Producci?n exige base HTTPS.
MediaStorage__PublicBaseUrl=http://127.0.0.1:5188

# Medios: configurar solo en backend, nunca APK. Producci?n exige base HTTPS.
ContentSafety__Endpoint=

# Medios: configurar solo en backend, nunca APK. Producci?n exige base HTTPS.
ContentSafety__ApiKey=

# Orders: use the full, versioned HTTPS key identifier from Key Vault (non-secret).
# Azure App Service authenticates with its system-assigned managed identity.
Orders__KeyVaultKeyId=
# Local fallback and legacy v1 reader; keep the same secret until all v1 records have been migrated.
Orders__AddressEncryptionKeyBase64=
